{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyledger",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "keyledger.rizanto.web.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keyledger-db",
      "database_id": "b000b20e-4765-4afc-9348-9938cb7f3aa8",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "APP_NAME": "KeyLedger",
    "APP_ENV": "production",
    "APP_URL": "https://keyledger.rizanto.web.id",
    "AUTH_OPEN_SIGNUP": "true",
    "SESSION_COOKIE_NAME": "keyledger_session",
    "REMEMBER_COOKIE_NAME": "keyledger_remember",
    "SESSION_LIFETIME": "2592000",
    "ADMIN_EMAILS": "ilhamgb11@gmail.com",
    "ALLOWED_EMAILS": "",
    "ALLOWED_DOMAINS": "",
    "MAIL_FROM_EMAIL": "noreply@localhost",
    "MAIL_FROM_NAME": "KeyLedger",
    "KEYCLOAK_BASE_URL": "",
    "KEYCLOAK_REALM": "",
    "KEYCLOAK_SCOPE": "openid email profile"
  }
}